{
  "name": "behatsdaa-stores-list",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/merge_all_clubs.js && node scripts/split-data.js && node scripts/fetch-models-at-build.js",
    "dev": "tsx server.ts",
    "build": "node scripts/merge_all_clubs.js && node scripts/split-data.js && node scripts/fetch-models-at-build.js && tsc && vite build",
    "pretest": "node scripts/merge_all_clubs.js && node scripts/split-data.js && node scripts/fetch-models-at-build.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.server.json --noEmit",
    "start": "tsx server.ts",
    "process-data": "node scripts/split-data.js",
    "update-data": "node scripts/split-data.js",
    "geocode": "node scripts/geocode-stores.js",
    "preview": "vite preview --port 3000 --host 0.0.0.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/http": "^0.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@google/genai": "^2.28.0",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@googlemaps/markerclusterer": "^2.6.2",
    "@types/express": "^5.0.6",
    "clsx": "^2.1.1",
    "express": "^4.21.2",
    "lucide-react": "^0.453.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
